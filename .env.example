# Local development configuration. Copy to `.env` (git-ignored) and fill in.
# `task dev` sets ARGUS_LOAD_DOTENV=1 so this file is read. If you launch the
# app another way, export ARGUS_LOAD_DOTENV=1 yourself. Packaged/release builds
# never read this file; they get these values baked in at build time from
# GitHub Actions secrets (see docs/guides/releases-and-secrets.md).
# Real environment variables always take priority over values here.

# GitHub MCP sign-in (OAuth App)
ARGUS_GITHUB_CLIENT_ID=
ARGUS_GITHUB_CLIENT_SECRET=

# Google MCP sign-in
ARGUS_GOOGLE_CLIENT_ID=
ARGUS_GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public origin used for the OAuth callback (/api/integrations/oauth/callback)
ARGUS_PUBLIC_URL=
